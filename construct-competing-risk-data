2. Construct competing-risk data ---------------------

# KMsurv documentation defines:
# t2 = time to relapse, death, or end of study
# d2 = relapse indicator
# d3 = indicator of death OR relapse
#
# Derivation for first event:
#   status = 1: relapse (d2 = 1)
#   status = 2: death before relapse (d3 = 1 and d2 = 0)
#   status = 0: censored/event-free at last follow-up (d3 = 0)
#
# This uses the first disease-free-survival event time t2. We validate the
# event indicators and stop rather than silently re coding unexpected patterns.

bmt <- bmt_raw |>
  mutate(
    disease_group = factor(
      group,
      levels = c(1, 2, 3),
      labels = c("ALL", "AML low risk", "AML high risk")
    ),
    # Use explicit labels to make event coding clear throughout the analysis.
    event_status = case_when(
      d2 == 1 ~ 1L,
      d3 == 1 & d2 == 0 ~ 2L,
      d3 == 0 & d2 == 0 ~ 0L,
      TRUE ~ NA_integer_
    ),
    event_type = factor(
      event_status,
      levels = c(0, 1, 2),
      labels = c("Censored", "Relapse", "Death before relapse")
    ),
    patient_sex = factor(z3, levels = c(0, 1), labels = c("Female", "Male")),
    patient_cmv = factor(z5, levels = c(0, 1), labels = c("Negative", "Positive")),
    donor_cmv = factor(z6, levels = c(0, 1), labels = c("Negative", "Positive")),
    mtx = factor(z10, levels = c(0, 1), labels = c("No", "Yes")),
    time = as.numeric(t2)
  )

if (anyNA(bmt$event_status)) {
  stop("Unexpected or missing d2/d3 combination. Review event coding.")
}
if (any(!is.finite(bmt$time)) || any(bmt$time <= 0)) {
  stop("Follow-up times must be finite and positive.")
}
if (any(!bmt$d2 %in% c(0, 1)) || any(!bmt$d3 %in% c(0, 1))) {
  stop("Unexpected values in d2/d3 event indicators.")
}
if (any(bmt$d2 == 1 & bmt$d3 != 1)) {
  stop("Data consistency check failed: relapse should count as a DFS event.")
}

# Cross-check event indicator derivation against documented d3 definition.
if (any((bmt$event_status != 0) != (bmt$d3 == 1))) {
  stop("Derived event status does not agree with d3.")
}

event_coding_check <- bmt |>
  count(d2, d3, event_type, name = "n") |>
  arrange(d2, d3)
write_csv_safe(event_coding_check,
               file.path(output_dir, "tables", "event_coding_check.csv"))

analysis_data <- bmt |>
  select(
    patient_id, disease_group, time, event_status, event_type,
    patient_age = z1, donor_age = z2, patient_sex,
    patient_cmv, donor_cmv, waiting_time = z7, mtx,
    d1, d2, d3, t1, t2
  ) |>
  drop_na(disease_group, time, event_status, patient_age, patient_sex)

write_csv_safe(analysis_data, file.path(output_dir, "tables", "analysis_data.csv"))
